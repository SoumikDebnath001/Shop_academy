# Admin panel security (password + email OTP + Google Authenticator)
# Keep ADMIN_2FA_ENCRYPTION_KEY unchanged once admins have set up Google Authenticator, otherwise they must set it up again
ADMIN_JWT_SECRET=
ADMIN_2FA_ENCRYPTION_KEY=
# Only needed to create the very first admin (send it as the x-admin-setup-key header to /api/v1/admin/register)
# ADMIN_SETUP_KEY=

# Email for admin login codes (without SMTP, codes are printed in the server console in development only)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Admin panel frontend origin (CORS)
ADMIN_FRONTEND_URL=
